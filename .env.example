# === REQUIRED ===

# OpenAI -- powers the research agent
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key

# Reddit -- create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yourapp/0.1 by u/yourusername

# YouTube Data API v3
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key
YOUTUBE_API_KEY=your-google-cloud-api-key
ELASTIC_CLOUD_ID=your-deployment:base64stuff
ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io:443
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX=youtube-product-comments
CORS_ORIGINS=http://localhost:3000

# Ask Vox: private ElevenLabs agent and a public HTTPS URL for its webhook tools.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=
PUBLIC_BASE_URL=https://your-public-api.example.com

# === OPTIONAL (only if you use the browser sources for X / Instagram) ===
BROWSERBASE_API_KEY=bb_live_your-key
BROWSERBASE_PROJECT_ID=your-project-uuid
# Stagehand uses an OpenAI key to navigate; reuses OPENAI_API_KEY if unset
MODEL_API_KEY=

# Hacker News needs NO key (public Algolia API).
