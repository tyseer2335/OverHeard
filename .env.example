# ============================================================================
# Voxmarket — environment configuration
# Copy to `.env` (backend reads this file). NOTHING here is required to run in
# offline/fixture mode — the app degrades gracefully when a key is missing.
# ============================================================================

# --- App ---
APP_ENV=dev
PORT=8000
# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000
# Public URL the ElevenLabs agent uses to reach our webhook tools.
# During a live demo this is your tunnel URL, e.g. https://xxxx.ngrok.app
PUBLIC_BASE_URL=http://localhost:8000

# --- Elasticsearch (PRIMARY prize) --------------------------------------------
# Option A: local Docker (see docker-compose.yml). Security is disabled locally.
ELASTICSEARCH_URL=http://localhost:9200
# Option B: Elastic Cloud / event deployment (leave URL blank and set these):
# ELASTIC_CLOUD_ID=
# ELASTIC_API_KEY=
ES_INDEX_PREFIX=voxmarket
# Set true ONLY when your ES deployment has a semantic_text inference endpoint
# (Elastic Cloud / event deployment). Locally leave false -> dense_vector path.
ES_USE_SEMANTIC_TEXT=false
# Inference endpoint id used by semantic_text (cloud mode). ELSER default id:
ES_INFERENCE_ID=.elser-2-elasticsearch

# --- OpenAI (STRONG prize) ----------------------------------------------------
# Used for: structured extraction (Responses API + strict JSON Schema) and
# embeddings (dense_vector). If unset, extraction uses a heuristic fallback and
# semantic search degrades to BM25 — the demo still runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536

# --- ElevenLabs (PRIMARY prize / FOCUS) ---------------------------------------
# Server-side ONLY. Never expose to the frontend.
ELEVENLABS_API_KEY=
# Created by backend/scripts/setup_elevenlabs_agent.py (or from the dashboard).
ELEVENLABS_AGENT_ID=
# Shared secret sent by the agent's webhook tools as the `X-Tool-Secret` header.
# We verify it on every webhook call. Generate with: openssl rand -hex 32
ELEVENLABS_TOOL_SECRET=dev-tool-secret-change-me
# Optional: change Vox's voice. Get an id from the ElevenLabs Voices library or
# GET /v1/voices, then rerun the setup script. Blank = leave the agent's voice as-is.
ELEVENLABS_VOICE_ID=

# --- Browserbase + Stagehand (STRONG prize, optional) -------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Sentry (OPTIONAL) --------------------------------------------------------
SENTRY_DSN=
